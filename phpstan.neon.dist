# PHPStan هدیما (اجرا: bash bin/lint.sh یا vendor/bin/phpstan)
# سطح ۶: نوع پارامتر/خروجی همه توابع لازم است (هدف مرحله ۳ نقشه راه، بخش ۵۷).
# خطاهای قدیمی در tools/quality/baseline/phpstan.neon ثبت‌اند؛ فقط خطای جدید رد می‌شود.
# بعد از رفع خطاهای قدیمی: bash bin/lint.sh --update-baseline
includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon
	- tools/quality/baseline/phpstan.neon

parameters:
	level: 6
	phpVersion: 80400
	paths:
		- hodima
		# اسکیمای افزونه‌ها (همان مسیرهای phpcs.xml.dist)
		- plugins/hodima-core/includes/schema-graph.php
		- plugins/hodima-core/includes/jalali.php
		- plugins/hodima-commerce/core/time-jalali
		- plugins/hodima-seo/schema
		- plugins/hodima-seo/inc/product-price.php
		- plugins/hodima-seo/inc/torob.php
		- plugins/hodima-seo/inc/torob-admin.php
		- plugins/hodima-seo/core/router/report.php
	excludePaths:
		analyse:
			- hodima/user-panel/*
			- plugins/hodima-seo/schema/admin/*
			- plugins/hodima-seo/schema/sitemap-core.php
			- plugins/hodima-seo/schema/podcast-feed-core.php
	bootstrapFiles:
		- tools/quality/phpstan-bootstrap.php
	scanFiles:
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
	# قالب توابع و کلاس‌های افزونه‌های هدیما را (با گارد) صدا می‌زند؛ فقط شناخته شوند، تحلیل نشوند
	scanDirectories:
		- plugins
	# توابع افزونه‌های هدیما و ووکامرس ممکن است نباشند؛ قالب با function_exists گارد می‌کند
	reportUnmatchedIgnoredErrors: false
	treatPhpDocTypesAsCertain: false
	# have_posts() و مشابه هر بار مقدار تازه می‌دهند (هشدار اشتباه «حلقه همیشه درست»)
	rememberPossiblyImpureFunctionValues: false
