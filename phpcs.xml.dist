<?xml version="1.0"?>
<!--
	قواعد PHPCS هدیما (اجرا: bash bin/lint.sh یا vendor/bin/phpcs)

	پایه: WordPress-Extra (امنیت: escape خروجی، nonce، پاک‌سازی ورودی، SQL آماده؛
	درستی API وردپرس؛ خطاهای رایج PHP) + چند قاعده نوسازی.
	قواعد صرفا ظاهری (تب به‌جای فاصله، تراز کردن =>، شکل فراخوانی چندخطی،
	نقطه آخر کامنت) عمدا خاموش‌اند: کد فعلی سبک خودش را دارد و هزاران
	هشدار ظاهری، هشدارهای مهم (امنیت) را گم می‌کرد.
	آرایه کوتاه [] و ?: مجاز (PHP مدرن)؛ array() قدیمی هشدار می‌دهد.

	خطاهای قدیمی در tools/quality/baseline/phpcs.json ثبت‌اند (فقط بیشتر شدن
	خطا رد می‌شود) — بعد از رفع: bin/lint.sh با گزینه update-baseline.
-->
<ruleset name="Hodima">
	<description>Hodima coding standard</description>

	<!-- قالب + اسکیمای افزونه‌ها (گراف واحد Core و سازنده‌های SEO)؛ بقیه افزونه‌ها بعدا مسیرشان را اینجا اضافه کنند -->
	<file>hodima</file>
	<file>plugins/hodima-core/includes/schema-graph.php</file>
	<file>plugins/hodima-core/includes/jalali.php</file>
	<file>plugins/hodima-commerce/core/time-jalali</file>
	<file>plugins/hodima-seo/schema</file>
	<!-- قیمت و نام ترب (بخش ۱۰۱) -->
	<file>plugins/hodima-seo/inc/product-price.php</file>
	<file>plugins/hodima-seo/inc/torob.php</file>
	<file>plugins/hodima-seo/inc/search-console.php</file>
	<file>plugins/hodima-seo/core/advisor</file>
	<file>plugins/hodima-seo/inc/torob-admin.php</file>
	<!-- گزارش‌های آدرس تمیز (بخش ۱۲۵، ۱۲۶) -->
	<file>plugins/hodima-seo/core/router/report.php</file>
	<file>plugins/hodima-seo/core/router/links.php</file>
	<!-- ماژول استوری Hodima Media (بخش ۱۲۷) -->
	<file>plugins/hodima-media/components/hodima-Stories</file>
	<!-- باکس‌های بازشونده Hodima Media (بخش ۲۰۷) -->
	<file>plugins/hodima-media/components/expandable-boxes</file>
	<!-- اعلان‌ها Hodima Media (بخش ۲۱۰) -->
	<file>plugins/hodima-media/components/notification</file>
	<!-- ماژول ویدیوها Hodima Media (بخش ۲۱۶؛ کل پوشه از بخش ۲۲۱) -->
	<file>plugins/hodima-media/components/video-watch</file>
	<!-- فرم لید تلفنی Hodima Commerce (بخش ۲۲۸) -->
	<file>plugins/hodima-commerce/components/phone</file>
	<!-- داخل پوشه schema ولی اسکیما نیستند (سایت‌مپ، فید پادکست، صفحه‌های پیشخوان) -->
	<exclude-pattern>plugins/hodima-seo/schema/admin/*</exclude-pattern>
	<exclude-pattern>plugins/hodima-seo/schema/sitemap-core\.php</exclude-pattern>
	<exclude-pattern>plugins/hodima-seo/schema/podcast-feed-core\.php</exclude-pattern>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg value="s"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.4-"/>

	<rule ref="WordPress-Extra">
		<!-- سبک ظاهری (فاصله/تب، تراز، شکل فراخوانی و آرایه) -->
		<exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
		<exclude name="Generic.WhiteSpace.ScopeIndent"/>
		<exclude name="Universal.WhiteSpace.PrecisionAlignment"/>
		<exclude name="WordPress.Arrays.ArrayDeclarationSpacing"/>
		<exclude name="WordPress.Arrays.ArrayIndentation"/>
		<exclude name="WordPress.Arrays.MultipleStatementAlignment"/>
		<exclude name="Generic.Formatting.MultipleStatementAlignment"/>
		<exclude name="PEAR.Functions.FunctionCallSignature"/>
		<exclude name="Generic.Functions.FunctionCallArgumentSpacing"/>
		<exclude name="NormalizedArrays.Arrays.ArrayBraceSpacing"/>
		<exclude name="NormalizedArrays.Arrays.CommaAfterLast"/>
		<exclude name="Squiz.Functions.MultiLineFunctionDeclaration"/>
		<exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing"/>
		<exclude name="Squiz.WhiteSpace.SuperfluousWhitespace"/>
		<exclude name="Squiz.ControlStructures.ControlSignature"/>
		<exclude name="WordPress.WhiteSpace.ControlStructureSpacing"/>
		<exclude name="PSR2.Methods.FunctionClosingBrace"/>
		<exclude name="Squiz.PHP.EmbeddedPhp"/>
		<!-- پایان خط را tools/eol.py نگه می‌دارد (فایل‌های CRLF عمدی‌اند) -->
		<exclude name="Generic.Files.LineEndings"/>
		<!-- if بدون آکولاد یک‌خطی در کد قدیمی؛ کد جدید با آکولاد -->
		<exclude name="Generic.ControlStructures.InlineControlStructure"/>
		<!-- نام فایل‌های قالب‌های ووکامرس/وردپرس ثابت است (taxonomy-product_cat.php) -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- PHP مدرن: [] و ?: -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<!-- Yoda اجباری نیست -->
		<exclude name="WordPress.PHP.YodaConditions"/>
	</rule>

	<!-- مستندات: فقط وجود توضیح، نه نقطه و حرف بزرگ (کامنت‌ها فارسی‌اند) -->
	<rule ref="WordPress-Docs">
		<exclude name="Squiz.Commenting.InlineComment"/>
		<exclude name="Squiz.Commenting.BlockComment"/>
		<exclude name="Squiz.Commenting.FileComment"/>
		<exclude name="Squiz.Commenting.FunctionComment"/>
		<exclude name="Squiz.Commenting.ClassComment"/>
		<exclude name="Squiz.Commenting.VariableComment"/>
		<exclude name="Generic.Commenting.DocComment"/>
	</rule>

	<!-- نوسازی: آرایه کوتاه، strict_types در هر فایل (هدف مرحله ۳ نقشه راه) -->
	<rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
	<rule ref="Generic.PHP.RequireStrictTypes"/>

	<!--
		PHPCS 3 هنوز property hooks (PHP 8.4) را نمی‌شناسد و «get => …» را اعلان
		ویژگی بی‌نام می‌خواند. فقط فایل‌هایی که property hook دارند.
	-->
	<rule ref="PSR2.Classes.PropertyDeclaration">
		<exclude-pattern>*/inc/classes/class-hodima-theme-asset.php</exclude-pattern>
	</rule>

	<!-- همه نام‌های سراسری با پیشوند هدیما -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="hodima"/>
				<element value="HODIMA"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="hodima"/>
			</property>
		</properties>
	</rule>
</ruleset>
