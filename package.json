{
	"name": "hodima-quality",
	"private": true,
	"description": "ابزارهای کنترل کیفیت CSS و JS هدیما (فقط توسعه؛ در ZIP قالب و افزونه‌ها نیست)",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"lint": "bash bin/lint.sh",
		"lint:css": "stylelint \"hodima/**/*.css\"",
		"lint:js": "eslint hodima",
		"build:css": "node bin/build-css.mjs --check"
	},
	"devDependencies": {
		"@bramus/specificity": "^2.4.2",
		"@eslint/js": "^10.0.1",
		"browserslist": "^4.29.3",
		"eslint": "^10.12.0",
		"globals": "^17.13.0",
		"lightningcss": "^1.33.0",
		"playwright-core": "^1.56.1",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-use-logical": "^2.1.3"
	},
	"browserslist": [
		"> 0.2% in IR",
		"defaults",
		"chrome >= 88",
		"edge >= 88",
		"firefox >= 78",
		"safari >= 14.1",
		"ios_saf >= 14.5",
		"samsung >= 14",
		"opera >= 73"
	]
}
